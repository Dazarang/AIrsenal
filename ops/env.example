# AIrsenal Pi automation environment. Copy to ~/airsenal-data/env and fill in.
# chmod 600 the real file. ABSOLUTE paths only: AIrsenal does not expand '~'.

AIRSENAL_DATA_ROOT=/home/dazarang/airsenal-data
AIRSENAL_HOME=/home/dazarang/airsenal-data/home

FPL_TEAM_ID=5830642
FPL_LOGIN=
FPL_PASSWORD=

# From `claude setup-token` (valid ~1 year; renew via the same command)
CLAUDE_CODE_OAUTH_TOKEN=

# Scheduling: main run fires RUN_HOURS_BEFORE the deadline; chip reminder at
# REMIND_HOURS_BEFORE if a chip was decided for the gameweek.
RUN_HOURS_BEFORE=3
REMIND_HOURS_BEFORE=1

# Telegram credentials are read (never written) from the pquant env file.
PQUANT_ENV_FILE=/home/dazarang/pquant/app/.env

# Optimization knobs
WEEKS_AHEAD=3
NUM_THREAD=3
MAX_HIT=8
